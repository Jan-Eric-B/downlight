{
  "name": "downlight",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check": "npm run check:format && npm run check:lint && npm run check:types && npm run check:deny && npm test",
    "check:format": "prettier --check . && cargo fmt --all --check",
    "check:lint": "eslint . && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "check:types": "tsc",
    "check:deny": "cargo deny check",
    "test": "npm run test:rust && npm run test:page",
    "test:rust": "cargo test --workspace --locked",
    "test:page": "vitest run",
    "fixtures": "cargo test -p downlight-core --test rendered_fixtures --locked -- --ignored && cargo test -p downlight --locked write_contract_samples -- --ignored",
    "documents": "node scripts/generate-documents.js",
    "measure": "node scripts/measure.js"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.345",
    "@tauri-apps/api": "^2.12.4",
    "github-markdown-css": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
